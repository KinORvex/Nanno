# --- Aplicação ---
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nanno_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=nanno_analysis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Segurança / JWT ---
SECRET_KEY=troque-por-um-valor-aleatorio-longo-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=nanno-microalgae-images
S3_ENDPOINT_URL=
S3_PRESIGNED_URL_EXPIRATION=3600
S3_USE_SSL=true

# --- Upload ---
MAX_UPLOAD_SIZE_MB=25
